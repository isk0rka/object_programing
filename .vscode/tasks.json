
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build lab_1 (clang++)",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "-O0",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/triangle.cpp",
        "-o",
        "${workspaceFolder}/lab_1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run lab_1",
      "type": "shell",
      "command": "${workspaceFolder}/lab_1",
      "dependsOn": "build lab_1 (clang++)",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    }
  ]
}
