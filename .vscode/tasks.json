
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lab_1",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/triangle.cpp",
                "-o",
                "${workspaceFolder}/lab_1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
